    {
      "parameters": {
        "jsCode": "// ===== SETTINGS: change only here =====\nconst COUNTRY_CODE = '49';                 // Germany\nconst MAX_PER_RUN  = 20;                   // safety: max messages per run\nconst SKIP_STATUS  = ['sent', 'stop', 'unsubscribe'];  // rows with these Status values are skipped\nconst TEMPLATE =\n  'Hi {name},\\n\\n' +\n  'Hope you are doing well!\\n\\n' +\n  'We are reaching out from ChauTech Consulting. We help businesses automate repetitive workflows and optimize digital operations.\\n\\n' +\n  'Would you be open to a quick 10-minute chat next week to discuss how we can support your goals?\\n\\n' +\n  'Best regards,\\n' +\n  'ChauTech Consulting Team';\n// ======================================\n\nconst seen = new Set();\nconst out = [];\n\nfor (const item of $input.all()) {\n  const row = item.json;\n\n  // 1. skip rows that were already handled\n  const status = String(row.Status || '').trim().toLowerCase();\n  if (SKIP_STATUS.includes(status)) continue;\n\n  // 2. clean the phone number: digits only\n  let p = String(row.Phone || '').replace(/\\D/g, '');\n  if (p.startsWith('00')) p = p.slice(2);\n  if (p.startsWith('0'))  p = COUNTRY_CODE + p.slice(1);\n\n  // 3. skip wrong-length and duplicate numbers\n  if (p.length < 11 || p.length > 15) continue;\n  if (seen.has(p)) continue;\n  seen.add(p);\n\n  // 4. build the personal message\n  const name = String(row.Name || '').trim() || 'there';\n  out.push({ json: {\n    row_number: row.row_number,\n    Name: name,\n    Phone: p,\n    text: TEMPLATE.replace('{name}', name)\n  }});\n\n  // 5. stop at the safety limit\n  if (out.length >= MAX_PER_RUN) break;\n}\n\nreturn out;"
      },
